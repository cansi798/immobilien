---
// Grundgerüst: SEO-Head (Meta, OG, Schema.org RealEstateAgent), Header, Footer, Animationen.
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import { SITE, u } from "../consts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  transparentHeader?: boolean;
  ogImage?: string;
  schema?: Record<string, unknown>;
}
const { title, description, noindex = false, transparentHeader = false, ogImage, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage ? u(ogImage) : u("assets/og-image.jpg"), Astro.site);
const home = new URL(u(""), Astro.site).href;

const agent = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "@id": home + "#makler",
  name: SITE.name,
  url: home,
  image: og.href,
  logo: new URL(u("assets/logo-dunkel.png"), Astro.site).href,
  telephone: SITE.phoneTel,
  email: SITE.email,
  address: { "@type": "PostalAddress", streetAddress: "Mexikoring 27-29", postalCode: SITE.zip, addressLocality: SITE.city, addressCountry: "DE" },
  founder: { "@type": "Person", name: SITE.owner, jobTitle: "Zertifizierter Immobilienmakler (IHK & EIA)" },
  areaServed: [{ "@type": "City", name: "Hamburg" }, { "@type": "State", name: "Schleswig-Holstein" }],
  openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "09:00", closes: "18:00" }],
  sameAs: [SITE.instagram],
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={u("sitemap.xml")} />
    <link rel="icon" href={u("favicon.ico")} sizes="48x48" />
    <link rel="icon" href={u("assets/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={u("assets/favicon-180.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#141414" />
    <script type="application/ld+json" set:html={JSON.stringify(agent)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <IconSprite />
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <div class="tageszeit" aria-hidden="true" title="Tageszeit: Morgen bis Abend"><i></i></div>
    <div class="cursor" aria-hidden="true"><span></span></div>
    <script>
      // Alle Bewegungen in EINER rAF-Schleife. Ohne JS fehlt html.js → alles statisch sichtbar.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
      const root = document.documentElement;

      // 1) Einblenden + Zähler
      const els = document.querySelectorAll(".reveal, .reveal-img, .draw, .reveal-steps, [data-count]");
      const show = (el: Element) => {
        el.classList.add("is-visible");
        const t = el as HTMLElement;
        if (t.dataset.count && !reduce) {
          const end = Number(t.dataset.count); const start = performance.now();
          const step = (now: number) => {
            const p = Math.min(1, (now - start) / 1500);
            t.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      };
      if ("IntersectionObserver" in window && !reduce) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { show(e.target); io.unobserve(e.target); }
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.06 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add("is-visible"));

      // 2) Scroll-gekoppelte Szenen
      const hx = document.getElementById("hx");
      const ws = document.querySelector<HTMLElement>(".ws");
      const wsTrack = ws?.querySelector<HTMLElement>(".ws__track");
      const px = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));
      let hxTop = 0, hxH = 0, wsTop = 0, wsH = 0, wsDist = 0, docH = 1, vh = innerHeight;
      const wsOn = () => !!ws && !reduce && innerWidth >= 820 && innerWidth > innerHeight;

      const measure = () => {
        vh = innerHeight;
        if (ws && wsTrack) {
          if (wsOn()) {
            ws.classList.add("ws--h");
            wsDist = Math.max(0, wsTrack.scrollWidth - innerWidth);
            ws.style.height = `${wsDist + vh}px`;
          } else { ws.classList.remove("ws--h"); ws.style.height = ""; wsTrack.style.removeProperty("--tx"); }
          wsTop = ws.getBoundingClientRect().top + scrollY; wsH = ws.offsetHeight;
        }
        if (hx) { hxTop = hx.getBoundingClientRect().top + scrollY; hxH = hx.offsetHeight; }
        docH = Math.max(1, document.documentElement.scrollHeight - vh);
      };

      if (hx && reduce) hx.classList.add("hx--static");
      let ticking = false;
      const frame = () => {
        ticking = false;
        const y = scrollY;
        root.style.setProperty("--tod", (Math.min(1, y / docH)).toFixed(3));
        if (hx && !reduce) {
          const p = Math.min(1, Math.max(0, (y - hxTop + 0) / Math.max(1, hxH - vh)));
          const pm = Math.min(1, p / 0.72);
          hx.style.setProperty("--p", p.toFixed(4));
          const s0 = (innerWidth < 720 || innerHeight > innerWidth) ? 1.12 : innerWidth < 1100 ? 1.12 : 0.9;
          hx.style.setProperty("--s", (s0 * Math.pow(12, pm * pm * (3 - 2 * pm))).toFixed(4));
          hx.classList.toggle("is-end", p > 0.62);
        }
        if (ws && wsTrack && wsOn()) {
          const p = Math.min(1, Math.max(0, (y - wsTop) / Math.max(1, wsH - vh)));
          wsTrack.style.setProperty("--tx", `${(-p * wsDist).toFixed(1)}px`);
          ws.style.setProperty("--hp", p.toFixed(3));
        }
        if (px.length && !reduce && innerWidth >= 900) {
          for (const el of px) {
            const r = el.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) continue;
            const max = r.height * 0.05;
            const off = Math.max(-max, Math.min(max, (r.top + r.height / 2 - vh / 2) * -(Number(el.dataset.parallax) || 0.08)));
            (el.firstElementChild as HTMLElement).style.transform = `translate3d(0, ${off.toFixed(1)}px, 0) scale(1.12)`;
          }
        }
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
      // Handy: horizontale Wisch-Strecke → Fortschrittsbalken
      wsTrack?.addEventListener("scroll", () => {
        if (wsOn()) return;
        const m = wsTrack.scrollWidth - wsTrack.clientWidth;
        ws!.style.setProperty("--hp", (m > 0 ? wsTrack.scrollLeft / m : 0).toFixed(3));
      }, { passive: true });
      if (hx && !reduce) hx.style.setProperty("--s", String((innerWidth < 720 || innerHeight > innerWidth) ? 1.12 : innerWidth < 1100 ? 1.12 : 0.9));
      measure(); frame();
      addEventListener("scroll", onScroll, { passive: true });
      let rz = 0;
      addEventListener("resize", () => { clearTimeout(rz); rz = window.setTimeout(() => { measure(); frame(); }, 120); });
      addEventListener("load", () => { measure(); frame(); });

      // 3) Schlüssel dreht sich beim Antippen
      document.querySelectorAll<HTMLElement>(".key-turn").forEach((k) => k.addEventListener("pointerdown", () => k.classList.add("turn")));

      // 4) Nur Desktop mit Maus: Neigung, magnetische Buttons, Cursor-Follower
      if (fine && !reduce) {
        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((c) => {
          c.addEventListener("pointermove", (e) => {
            const r = c.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
            c.classList.add("tilting");
            c.style.setProperty("--ry", `${(x * 7).toFixed(2)}deg`);
            c.style.setProperty("--rx", `${(-y * 7).toFixed(2)}deg`);
          });
          c.addEventListener("pointerleave", () => { c.classList.remove("tilting"); c.style.setProperty("--rx", "0deg"); c.style.setProperty("--ry", "0deg"); });
        });
        document.querySelectorAll<HTMLElement>("[data-magnet]").forEach((m) => {
          m.addEventListener("pointermove", (e) => {
            const r = m.getBoundingClientRect();
            m.style.transform = `translate(${((e.clientX - r.left - r.width / 2) * 0.22).toFixed(1)}px, ${((e.clientY - r.top - r.height / 2) * 0.32).toFixed(1)}px)`;
          });
          m.addEventListener("pointerleave", () => { m.style.transform = ""; });
        });
        const cur = document.querySelector<HTMLElement>(".cursor")!;
        const label = cur.querySelector("span")!;
        let tx = -100, ty = -100, cx = -100, cy = -100, run = false;
        const loop = () => {
          cx += (tx - cx) * 0.2; cy += (ty - cy) * 0.2;
          cur.style.transform = `translate3d(${cx.toFixed(1)}px, ${cy.toFixed(1)}px, 0)`;
          if (Math.abs(tx - cx) + Math.abs(ty - cy) > 0.3) requestAnimationFrame(loop); else run = false;
        };
        addEventListener("pointermove", (e) => {
          tx = e.clientX; ty = e.clientY; cur.classList.add("on");
          const t = (e.target as Element).closest<HTMLElement>("[data-cursor]");
          cur.classList.toggle("big", !!t);
          if (t) label.textContent = t.dataset.cursor || "";
          if (!run) { run = true; requestAnimationFrame(loop); }
        }, { passive: true });
        document.addEventListener("pointerleave", () => cur.classList.remove("on"));
      }
    </script>
  </body>
</html>
