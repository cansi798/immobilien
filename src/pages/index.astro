---
import BaseLayout from "../layouts/BaseLayout.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import HeroMask from "../components/HeroMask.astro";
import WegSteps from "../components/WegSteps.astro";
import ObjektCard from "../components/ObjektCard.astro";
import Stimmen from "../components/Stimmen.astro";
import Faq from "../components/Faq.astro";
import Finale from "../components/Finale.astro";
import { SITE, u, bild } from "../consts";
import { LEISTUNGEN, VORTEILE, FAQ_START } from "../data/leistungen";
import daten from "../data/objekte.json";
import b from "../data/bilder.json";

const portrait = b.portrait[0];
const highlights = ["poppenbuettel", "lemsahl-mellingstedt-doppelhaushaelfte", "geesthacht-mehrfamilienhaus"].map((s) => daten.angebote.find((o) => o.slug === s)!);
const verkaufen = LEISTUNGEN.find((l) => l.slug === "verkaufen")!;
const vermittelt = daten.vermittelt;
const wortBild = u("img/stimmung-garten-1400.webp");
const vk = bild("img/objekte/lemsahl-mellingstedt-doppelhaushaelfte/01");
const kf = bild("img/objekte/poppenbuettel/02");
---
<BaseLayout
  title="Henrick Jung Immobilien | Immobilienmakler in Hamburg"
  description="Immobilie verkaufen oder ein neues Zuhause finden in Hamburg und Umland – persönlich begleitet von Henrick Jung, zertifizierter Immobilienmakler (IHK & EIA). Vom ersten Anruf bis zur Schlüsselübergabe."
>
  <HeroMask />

  <!-- STATEMENT mit Fotowort -->
  <section class="section section--papier stm">
    <div class="container">
      <p class="eyebrow reveal">Über Henrick Jung Immobilien</p>
      <h2 class="stm__h reveal" style="--d:80ms">Hinter jeder <span class="foto-wort" style={`background-image:linear-gradient(rgba(13,21,36,.38),rgba(13,21,36,.38)),url(${wortBild})`}>Tür</span> beginnt eine <em>Geschichte.</em></h2>
      <div class="stm__grid">
        <div class="stm__portrait pic reveal-img" style="--curtain: var(--morgen)"><Img src={portrait.src} w={portrait.w} h={portrait.h} alt="Henrick Jung, Immobilienmakler in Hamburg" sizes="(min-width: 900px) 260px, 50vw" /></div>
        <div class="stm__text">
          <p class="lead reveal">Die Freude am Umgang mit Menschen ist das Fundament meiner Arbeit. Ob Kauf, Verkauf oder Vermietung – mein Kunde steht immer im Mittelpunkt.</p>
          <p class="reveal" style="--d:80ms">Als gelernter Bankkaufmann, studierter Wirtschaftspsychologe und zertifizierter Immobilienmakler (IHK & EIA) verbinde ich fachliche Kompetenz mit dem, was mir am wichtigsten ist: dem Menschlichen.</p>
          <a class="link-arrow reveal" style="--d:140ms" href={u("henrick-jung/")}>Meine Geschichte <Icon name="arrow" size={20} /></a>
        </div>
        <dl class="stm__zahlen">
          <div class="reveal"><dt><span data-count="13">13</span></dt><dd>vermittelte Objekte, auf dieser Website dokumentiert</dd></div>
          <div class="reveal" style="--d:100ms"><dt><span data-count="24">24</span><small>h</small></dt><dd>bis zu passenden Objektvorschlägen für Käufer</dd></div>
          <div class="reveal" style="--d:200ms"><dt><span data-count="3">3</span></dt><dd>Bundesländer: Hamburg, Schleswig-Holstein, Mecklenburg-Vorpommern</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ZWEI WEGE: Split-Panels -->
  <section class="wg" aria-label="Verkaufen oder kaufen">
    <a class="wg__p" href={u("leistungen/verkaufen/")} data-cursor="Verkaufen">
      <Img src={vk.src} w={vk.w} h={vk.h} alt="Doppelhaushälfte im Landhausstil in Hamburg-Lemsahl-Mellingstedt" sizes="(min-width: 900px) 60vw, 100vw" />
      <div class="wg__c">
        <p class="wg__k">01 · Für Eigentümer – privat & gewerblich</p>
        <h2 class="wg__w">Verkaufen<span>.</span></h2>
        <div class="wg__mehr"><div><p class="wg__t">Hinter jeder Immobilie steht eine Geschichte. Ich sorge dafür, dass das nächste Kapitel gut beginnt – mit realistischer Einwertung, hochwertiger Präsentation und einem Verkauf, der sich richtig anfühlt.</p>
        <ul class="wg__l"><li>Häuser, Wohnungen & Grundstücke</li><li>Mehrfamilien-, Anlage- & Gewerbeimmobilien</li><li>Netzwerk + alle großen Portale</li></ul></div></div>
        <span class="wg__cta">Verkauf besprechen <Icon name="arrow" size={20} /></span>
      </div>
    </a>
    <a class="wg__p key-turn" href={u("leistungen/kaufen/")} data-cursor="Kaufen">
      <Img src={kf.src} w={kf.w} h={kf.h} alt="Heller Essbereich mit Kaminofen und Blick in den Garten" sizes="(min-width: 900px) 60vw, 100vw" />
      <div class="wg__c">
        <p class="wg__k">02 · Für Käufer & Familien</p>
        <h2 class="wg__w">Kaufen<span>.</span></h2>
        <div class="wg__mehr"><div><p class="wg__t">Der Moment, in dem man eine Tür öffnet und weiß: Hier wollen wir leben. Für diesen Moment arbeite ich – teilen Sie mir Ihre Wünsche mit.</p>
        <ul class="wg__l"><li>Passende Objekte innerhalb von 24 Stunden</li><li>Begleitung zu allen Besichtigungen</li><li>Zustandsprüfung & Verhandlung</li></ul></div></div>
        <span class="wg__cta"><Icon name="key" size={20} /> Zuhause finden</span>
      </div>
    </a>
  </section>

  <!-- OBJEKTE -->
  <section class="section section--papier">
    <div class="container">
      <div class="kopf">
        <h2 class="mega reveal">Etwas für<br /><em>Sie</em> dabei?</h2>
        <div class="kopf__r reveal" style="--d:120ms">
          <p>Eine Auswahl der Objekte, die ich vermarkte – vom Neubau-Bungalow bis zur Kapitalanlage. Angebote ändern sich laufend; fragen Sie die Verfügbarkeit gern direkt an.</p>
          <a class="btn btn--line" href={u("immobilien/")} data-magnet>Alle Immobilien <Icon name="arrow" size={18} /></a>
        </div>
      </div>
      <div class="og">
        {highlights.map((o, i) => <ObjektCard o={o} d={i * 120} gross={i === 0} />)}
      </div>
    </div>
  </section>

  <WegSteps items={verkaufen.ablauf} />

  <!-- VORTEILE -->
  <section class="section vt">
    <div class="container vt__grid">
      <div class="vt__kopf">
        <p class="eyebrow reveal">Meine Vorteile für Sie</p>
        <h2 class="mega vt__mega reveal" style="--d:80ms">Ver&shy;trauen<br />ist <em>Haltung.</em></h2>
        <p class="reveal" style="--d:140ms">Ich sehe mich als Partner meiner Kunden – denn gewinnt mein Kunde, gewinne auch ich.</p>
      </div>
      <ol class="vt__list">
        {VORTEILE.map((v, i) => (
          <li class="vt__i reveal" style={`--d:${i * 120}ms`}>
            <span class="vt__nr">0{i + 1}</span>
            <div><h3>{v.titel}</h3><p>{v.text}</p></div>
            <span class="vt__ico"><Icon name={v.icon} size={26} /></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- STIMMEN -->
  <section class="section nacht">
    <div class="container">
      <div class="head center">
        <p class="eyebrow reveal">Bewertungen</p>
        <h2 class="reveal" style="--d:80ms">Was Kunden <em>sagen</em></h2>
      </div>
      <Stimmen />
    </div>
  </section>

  <!-- REFERENZEN: Laufband -->
  <section class="section section--papier refs">
    <div class="container kopf">
      <h2 class="mega reveal">Bereits<br /><em>vermittelt.</em></h2>
      <div class="kopf__r reveal" style="--d:120ms">
        <p>Verkaufte und vermietete Immobilien aus Hamburg, Schleswig-Holstein und Mecklenburg-Vorpommern.</p>
        <a class="btn btn--line" href={u("immobilien/#vermittelt")} data-magnet>Alle Referenzen <Icon name="arrow" size={18} /></a>
      </div>
    </div>
    <div class="marquee" tabindex="0" aria-label="Bereits vermittelte Immobilien">
      <div class="marquee__track">
        {[...vermittelt, ...vermittelt].map((v, i) => (
          <figure class="ref" aria-hidden={i >= vermittelt.length ? "true" : undefined}>
            <div class="pic"><Img src={v.bild.src} w={v.bild.w} h={v.bild.h} alt={i >= vermittelt.length ? "" : `${v.typ} in ${v.ort} – ${v.status}`} sizes="340px" /></div>
            <figcaption><span class="ref__st">{v.status}</span> {v.typ} · {v.ort}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faqwrap">
      <div>
        <p class="eyebrow reveal">Häufige Fragen</p>
        <h2 class="mega faq__mega reveal" style="--d:80ms">Gut zu <em>wissen.</em></h2>
        <p class="reveal" style="--d:140ms">Ihre Frage ist nicht dabei? Rufen Sie mich an: <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a></p>
      </div>
      <Faq items={FAQ_START} />
    </div>
  </section>

  <Finale />
</BaseLayout>

<style>
  /* Statement */
  .stm__h { font-size: clamp(2.5rem, 7.2vw, 6.6rem); line-height: 1; letter-spacing: -.03em; font-weight: 400; max-width: 15ch; margin-bottom: 64px; }
  .stm__h .foto-wort { font-style: italic; font-weight: 600; }
  .stm__grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .stm__grid { grid-template-columns: 260px 1fr 1fr; gap: 56px; align-items: start; } .stm__text { padding-top: 40px; } }
  .stm__portrait { aspect-ratio: 4 / 5; border-radius: 999px 999px var(--r-lg) var(--r-lg); max-width: 260px; }
  .stm__zahlen { margin: 0; display: grid; gap: 24px; }
  .stm__zahlen div { border-top: 1px solid var(--linie); padding-top: 16px; display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: baseline; }
  .stm__zahlen dt { font-family: var(--serif); font-size: clamp(2.6rem, 4.4vw, 3.8rem); line-height: 1; color: var(--ink); }
  .stm__zahlen dt small { font-size: .5em; margin-left: 2px; color: var(--champagner-text); }
  .stm__zahlen dd { margin: 0; font-size: 14.5px; color: var(--stein); line-height: 1.5; }

  /* Zwei Wege */
  .wg { display: flex; flex-direction: column; background: var(--nacht); }
  .wg__p { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; min-height: 88svh; text-decoration: none; color: var(--weiss); }
  .wg__p > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transform: scale(1.06); transition: transform 1.6s var(--ease); }
  .wg__p::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(13,21,36,.45) 0%, rgba(13,21,36,.92) 70%); transition: background .8s var(--ease); }
  .wg__p:hover > :global(img) { transform: scale(1); }
  .wg__c { padding: 32px 20px 44px; width: 100%; }
  .wg__k { font-size: 12.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--champagner-hell); font-weight: 600; margin-bottom: 8px; }
  .wg__w { font-size: clamp(3.6rem, 14vw, 8.5rem); line-height: .9; letter-spacing: -.04em; color: var(--weiss); margin: 0 0 18px; font-weight: 400; }
  .wg__w span { color: var(--champagner); }
  .wg__t { color: #dde1e9; max-width: 520px; }
  .wg__l { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-wrap: wrap; gap: 8px; }
  .wg__l li { font-size: 13.5px; padding: 6px 14px; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; color: #eef0f4; }
  .wg__cta { display: inline-flex; align-items: center; gap: 12px; font-weight: 600; padding: 14px 26px; border-radius: 999px; background: var(--weiss); color: var(--ink); }
  @media (min-width: 900px) {
    .wg__p::before { background: linear-gradient(180deg, rgba(13,21,36,.1) 20%, rgba(13,21,36,.88) 85%); }
    .wg { flex-direction: row; height: 92svh; }
    .wg__p { flex: 1; min-height: 0; transition: flex 1s var(--ease); }
    .wg__p:hover, .wg__p:focus-visible { flex: 1.55; }
    .wg__c { padding: 56px; }
    .wg__w { font-size: clamp(3.6rem, 7.6vw, 8.5rem); }
    .wg__mehr { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .8s var(--ease); }
    .wg__mehr > div { overflow: hidden; min-height: 0; }
    .wg__l, .wg__t { opacity: 0; transform: translateY(14px); transition: opacity .6s var(--ease) .15s, transform .6s var(--ease) .15s; }
    .wg__p:hover .wg__mehr, .wg__p:focus-visible .wg__mehr { grid-template-rows: 1fr; }
    .wg__p:hover .wg__l, .wg__p:hover .wg__t, .wg__p:focus-visible .wg__l, .wg__p:focus-visible .wg__t { opacity: 1; transform: none; }
    .wg__p + .wg__p { border-left: 1px solid rgba(255,255,255,.12); }
  }
  @media (min-width: 900px) and (hover: none) { .wg__mehr { grid-template-rows: 1fr; } .wg__l, .wg__t { opacity: 1; transform: none; } }

  /* Kopfzeilen mit Mega-Typo */
  .kopf { display: grid; gap: 24px 64px; margin-bottom: 56px; align-items: end; }
  @media (min-width: 900px) { .kopf { grid-template-columns: 1.2fr 1fr; } }
  .kopf__r p { color: var(--graphit); }
  .mega em { color: var(--champagner-text); }
  .og { display: grid; gap: 24px; }
  @media (min-width: 720px) { .og { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .og { grid-template-columns: repeat(3, 1fr); } }

  /* Vorteile */
  .vt__grid { display: grid; gap: 48px; }
  @media (min-width: 1024px) { .vt__grid { grid-template-columns: 1fr 1.1fr; gap: 80px; align-items: center; } }
  .vt__mega { font-size: clamp(3rem, 8vw, 7rem); margin-bottom: 24px; }
  .vt__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linie); }
  .vt__i { display: grid; grid-template-columns: 52px 1fr auto; gap: 18px; padding: 28px 4px; border-bottom: 1px solid var(--linie); align-items: start; transition: background .5s var(--ease), padding .5s var(--ease); }
  .vt__i:hover { background: var(--stimmung); padding-inline: 16px; }
  .vt__nr { font-family: var(--serif); font-size: 1.6rem; color: var(--champagner-text); line-height: 1.2; }
  .vt__i h3 { margin-bottom: 6px; }
  .vt__i p { margin: 0; color: var(--stein); font-size: 16px; }
  .vt__ico { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--champagner-hell); display: grid; place-items: center; color: var(--champagner-text); }
  @media (max-width: 520px) { .vt__ico { display: none; } .vt__i { grid-template-columns: 44px 1fr; } }

  /* Referenzen */
  .refs .marquee { padding-block: 4px 8px; }
  .ref { flex: none; width: 340px; margin: 0; }
  .ref .pic { aspect-ratio: 3 / 2; border-radius: var(--r-lg); }
  .ref figcaption { margin-top: 12px; font-size: 14.5px; color: var(--graphit); }
  .ref__st { display: inline-block; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; background: var(--nacht); color: var(--weiss); padding: 3px 10px; border-radius: 999px; margin-right: 6px; }
  @media (max-width: 600px) { .ref { width: 260px; } }

  /* FAQ */
  .faqwrap { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .faqwrap { grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: start; } }
  .faq__mega { font-size: clamp(3rem, 7vw, 6rem); margin-bottom: 20px; }
  .faqwrap :global(.faq) { margin: 0; max-width: none; width: 100%; }
</style>
