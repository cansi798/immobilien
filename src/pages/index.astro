---
import BaseLayout from "../layouts/BaseLayout.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import RoofLine from "../components/RoofLine.astro";
import ObjektCard from "../components/ObjektCard.astro";
import Steps from "../components/Steps.astro";
import Stimmen from "../components/Stimmen.astro";
import Faq from "../components/Faq.astro";
import KontaktBand from "../components/KontaktBand.astro";
import { SITE, u, bild } from "../consts";
import { LEISTUNGEN, VORTEILE, FAQ_START } from "../data/leistungen";
import daten from "../data/objekte.json";
import b from "../data/bilder.json";

const hero = b.hero[0];
const portrait = b.portrait[0];
const garten = b.garten[0];
const highlights = ["poppenbuettel", "lemsahl-mellingstedt-doppelhaushaelfte", "geesthacht-mehrfamilienhaus"].map((s) => daten.angebote.find((o) => o.slug === s)!);
const verkaufen = LEISTUNGEN.find((l) => l.slug === "verkaufen")!;
const vermittelt = daten.vermittelt;
const h1Words = ["Wo", "Ihr", "neues", "Kapitel"];
const regionen = ["Hamburg", "Norderstedt", "Geesthacht", "Rellingen", "Schwarzenbek", "Hamburger Umland", "Mecklenburg-Vorpommern"];
---
<BaseLayout
  title="Henrick Jung Immobilien | Immobilienmakler in Hamburg"
  description="Immobilie verkaufen oder ein neues Zuhause finden in Hamburg und Umland – persönlich begleitet von Henrick Jung, zertifizierter Immobilienmakler (IHK & EIA). Vom ersten Anruf bis zur Schlüsselübergabe."
  transparentHeader
>
  <!-- HERO -->
  <section class="hero dark">
    <div class="hero__bg" aria-hidden="true">
      <Img src={hero.src} w={hero.w} h={hero.h} alt="" eager sizes="100vw" />
    </div>
    <div class="container hero__inner">
      <p class="eyebrow hero__in" style="--d:100ms">Immobilienmakler in Hamburg</p>
      <h1 class="hero__h1">
        {h1Words.map((w, i) => <span class="w"><span style={`--d:${200 + i * 110}ms`}>{w}</span></span>)}{" "}
        <span class="w"><em style="--d:660ms">beginnt.</em></span>
      </h1>
      <p class="lead hero__in" style="--d:850ms">
        Ob Sie Ihr Zuhause verkaufen oder ein neues suchen: Ich begleite Sie persönlich, ehrlich und mit fundierter regionaler Marktkenntnis – vom ersten Anruf bis zur Schlüsselübergabe.
      </p>
      <div class="btns hero__in" style="--d:1000ms">
        <a class="btn btn--hell" href={u("leistungen/verkaufen/")}><Icon name="key" size={18} /> Immobilie verkaufen</a>
        <a class="btn btn--line-hell" href={u("immobilien/")}><Icon name="home" size={18} /> Zuhause finden</a>
      </div>
      <ul class="hero__trust hero__in" style="--d:1150ms">
        <li><Icon name="award" size={20} /> Zertifiziert (IHK & EIA)</li>
        <li><Icon name="pin" size={20} /> {SITE.region}</li>
        <li><Icon name="user" size={20} /> Ein persönlicher Ansprechpartner</li>
      </ul>
    </div>
    <a class="hero__scroll" href="#einstieg" aria-label="Weiter zum Inhalt"><span></span></a>
  </section>

  <!-- ZWEI EINSTIEGE -->
  <section class="section" id="einstieg">
    <div class="container">
      <div class="head center">
        <p class="eyebrow reveal">Wie kann ich Ihnen helfen?</p>
        <h2 class="reveal" style="--d:80ms">Zwei Wege. <em>Ein</em> Ansprechpartner.</h2>
      </div>
      <div class="wege">
        <a class="weg reveal" href={u("leistungen/verkaufen/")}>
          <div class="weg__pic pic zoom"><Img {...bild("img/objekte/lemsahl-mellingstedt-doppelhaushaelfte/01")} alt="Doppelhaushälfte im Landhausstil mit gepflegtem Garten in Hamburg-Lemsahl-Mellingstedt" sizes="(min-width: 900px) 50vw, 100vw" /></div>
          <div class="weg__body">
            <p class="weg__kicker">Für Eigentümer – privat & gewerblich</p>
            <h3>Sie möchten verkaufen?</h3>
            <p>Hinter jeder Immobilie steht eine Geschichte. Ich sorge dafür, dass das nächste Kapitel gut beginnt – mit einer realistischen Einwertung, einer hochwertigen Präsentation und einem Verkauf, der sich für Sie richtig anfühlt.</p>
            <ul class="check">
              <li>Häuser, Wohnungen und Grundstücke</li>
              <li>Mehrfamilien-, Anlage- und Gewerbeimmobilien</li>
              <li>Netzwerk + alle großen Immobilienportale</li>
            </ul>
            <span class="link-arrow">Mehr zum Verkauf <Icon name="arrow" size={20} /></span>
          </div>
        </a>
        <a class="weg reveal" style="--d:140ms" href={u("leistungen/kaufen/")}>
          <div class="weg__pic pic zoom"><Img {...bild("img/objekte/poppenbuettel/02")} alt="Heller Essbereich mit Kaminofen und Blick in den Garten" sizes="(min-width: 900px) 50vw, 100vw" /></div>
          <div class="weg__body">
            <p class="weg__kicker">Für Käufer & Familien</p>
            <h3>Sie suchen ein Zuhause?</h3>
            <p>Der Moment, in dem man eine Tür öffnet und weiß: Hier wollen wir leben. Für diesen Moment arbeite ich. Teilen Sie mir Ihre Wünsche mit – den Rest übernehme ich mit Sorgfalt.</p>
            <ul class="check">
              <li>Passende Objekte innerhalb von 24 Stunden</li>
              <li>Begleitung zu allen Besichtigungen</li>
              <li>Zustandsprüfung und Verhandlung</li>
            </ul>
            <span class="link-arrow">Mehr zum Kauf <Icon name="arrow" size={20} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- AKTUELLE OBJEKTE -->
  <section class="section section--papier">
    <div class="container">
      <div class="head-row">
        <div class="head">
          <p class="eyebrow reveal">Ausgewählte Immobilien</p>
          <h2 class="reveal" style="--d:80ms">Etwas für Sie <em>dabei</em>?</h2>
          <p class="reveal" style="--d:140ms">Eine Auswahl der Objekte, die ich vermarkte. Angebote ändern sich laufend – fragen Sie die Verfügbarkeit gern direkt bei mir an.</p>
        </div>
        <a class="btn btn--line reveal" href={u("immobilien/")}>Alle Immobilien <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid g3">
        {highlights.map((o, i) => <ObjektCard o={o} d={i * 120} />)}
      </div>
    </div>
  </section>

  <!-- ABLAUF -->
  <section class="section">
    <div class="container">
      <div class="head center">
        <p class="eyebrow reveal">Ihr Verkauf, Schritt für Schritt</p>
        <h2 class="reveal" style="--d:80ms">So verkaufen Sie <em>mit mir</em></h2>
        <p class="reveal" style="--d:140ms">Klarer Ablauf, feste Ansprechperson, keine Überraschungen. Ich nehme Sie an die Hand und führe Sie durch den gesamten Prozess.</p>
      </div>
      <Steps items={verkaufen.ablauf} />
      <div class="text-center mt reveal"><a class="btn" href={u("kontakt/?anliegen=verkaufen")}>Verkauf besprechen</a></div>
    </div>
  </section>

  <!-- VORTEILE + ZAHLEN -->
  <section class="section dark vorteile">
    <div class="container">
      <div class="vt__grid">
        <div>
          <p class="eyebrow reveal">Meine Vorteile für Sie</p>
          <h2 class="reveal" style="--d:80ms">Vertrauen entsteht durch <em>Haltung</em>.</h2>
          <p class="reveal" style="--d:140ms">Ich sehe mich als Partner meiner Kunden – denn gewinnt mein Kunde, gewinne auch ich.</p>
          <dl class="zahlen">
            <div class="reveal"><dt><span data-count="13">13</span></dt><dd>vermittelte Objekte, auf dieser Website dokumentiert</dd></div>
            <div class="reveal" style="--d:100ms"><dt><span data-count="24">24</span>&thinsp;h</dt><dd>bis zu passenden Objektvorschlägen für Käufer</dd></div>
            <div class="reveal" style="--d:200ms"><dt><span data-count="3">3</span></dt><dd>Bundesländer: Hamburg, Schleswig-Holstein, Mecklenburg-Vorpommern</dd></div>
          </dl>
        </div>
        <div class="vt__list">
          {VORTEILE.map((v, i) => (
            <div class="vt reveal" style={`--d:${i * 120}ms`}>
              <span class="vt__ico"><Icon name={v.icon} size={26} /></span>
              <div><h3>{v.titel}</h3><p>{v.text}</p></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ÜBER MICH -->
  <section class="section ueber">
    <div class="container ueber__grid">
      <div class="ueber__pics">
        <div class="ueber__garten pic pic--r reveal-img" data-parallax="0.06"><Img src={garten.src} w={garten.w} h={garten.h} alt="Garten mit Pavillon einer Hamburger Doppelhaushälfte" sizes="(min-width: 900px) 40vw, 100vw" /></div>
        <div class="ueber__portrait pic pic--r reveal-img" style="--d:250ms"><Img src={portrait.src} w={portrait.w} h={portrait.h} alt="Henrick Jung, Gründer von Henrick Jung Immobilien" sizes="(min-width: 900px) 280px, 55vw" /></div>
      </div>
      <div>
        <RoofLine width={160} />
        <p class="eyebrow reveal">Über mich – ganz persönlich</p>
        <h2 class="reveal" style="--d:80ms">„Bei mir sind Sie an der <em>richtigen Adresse</em>.“</h2>
        <p class="lead reveal" style="--d:140ms">Die Freude am Umgang mit Menschen ist das Fundament meiner Arbeit. Ob Kauf, Verkauf oder Vermietung – mein Kunde steht immer im Mittelpunkt.</p>
        <p class="reveal" style="--d:200ms">Als gelernter Bankkaufmann, studierter Wirtschaftspsychologe und zertifizierter Immobilienmakler (IHK & EIA) verbinde ich fachliche Kompetenz mit dem, was mir am wichtigsten ist: dem Menschlichen.</p>
        <p class="sign reveal" style="--d:260ms">Henrick Jung<small>{SITE.role}</small></p>
        <a class="link-arrow reveal" style="--d:300ms" href={u("henrick-jung/")}>Meine Geschichte lesen <Icon name="arrow" size={20} /></a>
      </div>
    </div>
  </section>

  <!-- STIMMEN -->
  <section class="section dark">
    <div class="container">
      <div class="head center">
        <p class="eyebrow reveal">Bewertungen</p>
        <h2 class="reveal" style="--d:80ms">Was Kunden <em>sagen</em></h2>
      </div>
      <Stimmen />
    </div>
  </section>

  <!-- VERMITTELT -->
  <section class="section section--papier">
    <div class="container">
      <div class="head-row">
        <div class="head">
          <p class="eyebrow reveal">Referenzen</p>
          <h2 class="reveal" style="--d:80ms">Bereits <em>vermittelt</em></h2>
          <p class="reveal" style="--d:140ms">Ein Ausschnitt verkaufter und vermieteter Immobilien aus Hamburg und dem Umland.</p>
        </div>
        <a class="btn btn--line reveal" href={u("immobilien/#vermittelt")}>Alle Referenzen <Icon name="arrow" size={18} /></a>
      </div>
    </div>
    <div class="ref-strip" tabindex="0" aria-label="Bereits vermittelte Immobilien (horizontal scrollbar)">
      {vermittelt.slice(0, 8).map((v, i) => (
        <figure class="ref reveal" style={`--d:${(i % 4) * 90}ms`}>
          <div class="pic pic--r zoom"><Img src={v.bild.src} w={v.bild.w} h={v.bild.h} alt={`${v.typ} in ${v.ort} – ${v.status}`} sizes="(min-width: 900px) 360px, 75vw" /></div>
          <figcaption><span class="ref__st">{v.status}</span> {v.typ} · {v.ort}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- REGION -->
  <section class="section">
    <div class="container region">
      <div>
        <p class="eyebrow reveal">Region</p>
        <h2 class="reveal" style="--d:80ms">Zuhause in Hamburg <em>& Umland</em></h2>
        <p class="reveal" style="--d:140ms">Von den Walddörfern über das Alstertal bis ins Umland: Meine fundierten regionalen Marktkenntnisse sind Ihr Vorteil – beim Verkauf wie beim Kauf.</p>
        <ul class="region__tags reveal" style="--d:200ms">{regionen.map((r) => <li>{r}</li>)}</ul>
      </div>
      <div class="region__card reveal" style="--d:160ms">
        <Icon name="pin" size={28} />
        <h3>{SITE.name}</h3>
        <p>{SITE.street}<br />{SITE.zip} {SITE.city}</p>
        <a class="link-arrow" href={SITE.mapUrl} target="_blank" rel="noopener">Auf der Karte ansehen <Icon name="arrow" size={20} /></a>
        <p class="small">Externer Link zu OpenStreetMap – es werden erst beim Klick Daten übertragen.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--papier">
    <div class="container">
      <div class="head center">
        <p class="eyebrow reveal">Häufige Fragen</p>
        <h2 class="reveal" style="--d:80ms">Gut zu <em>wissen</em></h2>
      </div>
      <Faq items={FAQ_START} />
    </div>
  </section>

  <KontaktBand />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; min-height: min(100svh, 920px); display: flex; align-items: flex-end; overflow: hidden; padding-top: var(--header-h); }
  .hero__bg { position: absolute; inset: 0; }
  .hero__bg :global(img) { width: 100%; height: 100%; object-fit: cover; animation: kb 22s var(--ease) both; }
  .hero__bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,.55) 0%, rgba(10,10,10,.25) 35%, rgba(10,10,10,.78) 100%), linear-gradient(90deg, rgba(10,10,10,.55), rgba(10,10,10,0) 70%); }
  .hero__inner { position: relative; padding-block: 64px 96px; }
  @media (min-width: 900px) { .hero__inner { padding-block: 120px 120px; } }
  .hero__h1 { color: var(--weiss); font-size: clamp(2.6rem, 7vw, 5.6rem); max-width: 900px; margin-bottom: 24px; line-height: 1.04; }
  .hero__h1 em { color: var(--champagner-hell); }
  .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .08em; margin-right: .22em; }
  .w > * { display: inline-block; animation: rise 1.1s var(--ease) both; animation-delay: var(--d); }
  .hero .lead { color: #e8e8e8; max-width: 620px; }
  .hero__in { animation: fade 1s var(--ease) both; animation-delay: var(--d); }
  .hero__trust { list-style: none; margin: 40px 0 0; padding: 24px 0 0; border-top: 1px solid rgba(255,255,255,.2); display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 14.5px; color: #e6e6e6; }
  .hero__trust li { display: inline-flex; align-items: center; gap: 10px; }
  .hero__trust :global(.icon) { color: var(--champagner-hell); }
  .hero__scroll { position: absolute; right: 32px; bottom: 40px; width: 28px; height: 46px; border: 1px solid rgba(255,255,255,.6); border-radius: 20px; display: none; }
  .hero__scroll span { position: absolute; left: 50%; top: 9px; width: 2px; height: 8px; margin-left: -1px; background: var(--weiss); border-radius: 2px; animation: scrolly 2s ease-in-out infinite; }
  @media (min-width: 900px) { .hero__scroll { display: block; } }
  @keyframes kb { from { transform: scale(1.14) translate3d(-1%, 1%, 0); } to { transform: scale(1.02) translate3d(0, 0, 0); } }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes fade { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes scrolly { 0% { opacity: 0; transform: translateY(0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }

  /* WEGE */
  .wege { display: grid; gap: 28px; }
  @media (min-width: 900px) { .wege { grid-template-columns: 1fr 1fr; } }
  .weg { display: flex; flex-direction: column; text-decoration: none; color: inherit; border: 1px solid var(--linie); border-radius: var(--r-lg); overflow: hidden; background: var(--weiss); transition: box-shadow var(--t), opacity 900ms var(--ease), transform 900ms var(--ease); }
  .weg:hover { box-shadow: var(--shadow-lg); }
  .weg__pic { aspect-ratio: 16 / 10; }
  .weg__body { padding: 32px 28px 36px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  @media (min-width: 900px) { .weg__body { padding: 40px 44px 44px; } }
  .weg__kicker { font-size: 12.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--champagner-text); font-weight: 600; margin-bottom: 8px; }
  .weg h3 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .weg .check { margin: 8px 0 28px; }
  .weg .link-arrow { margin-top: auto; }

  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 32px; margin-bottom: 48px; }
  .head-row .head { margin-bottom: 0; }
  .mt { margin-top: 56px; }

  /* VORTEILE */
  .vt__grid { display: grid; gap: 56px; }
  @media (min-width: 1024px) { .vt__grid { grid-template-columns: 1fr 1fr; gap: 96px; align-items: center; } }
  .zahlen { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 0; }
  .zahlen div { border-top: 1px solid rgba(255,255,255,.2); padding-top: 18px; }
  .zahlen dt { font-family: var(--serif); font-size: clamp(2.2rem, 4.5vw, 3.4rem); color: var(--champagner-hell); line-height: 1; margin-bottom: 10px; }
  .zahlen dd { margin: 0; font-size: 14px; color: #bdbdbd; line-height: 1.5; }
  @media (max-width: 520px) { .zahlen { grid-template-columns: 1fr; } }
  .vt__list { display: grid; gap: 16px; }
  .vt { display: flex; gap: 20px; padding: 28px; border: 1px solid rgba(255,255,255,.14); border-radius: var(--r-lg); }
  .vt__ico { width: 54px; height: 54px; flex: none; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--champagner); color: var(--champagner-hell); }
  .vt h3 { margin-bottom: 6px; }
  .vt p { margin: 0; font-size: 16px; }

  /* ÜBER */
  .ueber__grid { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 900px) { .ueber__grid { grid-template-columns: 1fr 1fr; gap: 88px; } }
  .ueber__pics { position: relative; padding-bottom: 60px; padding-right: 18%; }
  .ueber__garten { aspect-ratio: 4 / 3; }
  .ueber__garten :global(img) { will-change: transform; transform: scale(1.12); }
  .ueber__portrait { position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 4 / 5; border: 6px solid var(--weiss); box-shadow: var(--shadow-lg); }
  .sign { font-family: var(--serif); font-style: italic; font-size: 1.6rem; color: var(--ink); margin: 28px 0 20px; display: grid; }
  .sign small { font-family: var(--sans); font-style: normal; font-size: 14px; }

  /* REFERENZEN */
  .ref-strip { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px max(20px, calc((100vw - var(--max)) / 2 + 32px)) 24px; scrollbar-width: thin; }
  .ref { flex: none; width: min(75vw, 360px); margin: 0; scroll-snap-align: start; }
  .ref .pic { aspect-ratio: 3 / 2; }
  .ref figcaption { margin-top: 12px; font-size: 14.5px; color: var(--graphit); }
  .ref__st { display: inline-block; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; background: var(--ink); color: var(--weiss); padding: 3px 10px; border-radius: 999px; margin-right: 6px; }

  /* REGION */
  .region { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .region { grid-template-columns: 1.3fr 1fr; gap: 80px; } }
  .region__tags { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .region__tags li { padding: 8px 16px; border: 1px solid var(--linie); border-radius: 999px; font-size: 14.5px; }
  .region__card { padding: 40px; border-radius: var(--r-lg); background: var(--papier); border: 1px solid var(--linie); }
  .region__card :global(.icon) { color: var(--champagner-text); margin-bottom: 12px; }
  .region__card .small { margin-top: 16px; }
</style>
