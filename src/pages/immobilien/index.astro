---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ObjektCard from "../../components/ObjektCard.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import Finale from "../../components/Finale.astro";
import { u, SITE } from "../../consts";
import daten from "../../data/objekte.json";
const angebote = [...daten.angebote].sort((a, b) => a.order - b.order);
---
<BaseLayout title="Immobilien in Hamburg & Umland | Henrick Jung Immobilien" description="Häuser, Wohnungen, Grundstücke sowie Anlage- und Gewerbeimmobilien in Hamburg, Schleswig-Holstein und Mecklenburg-Vorpommern – Angebote und Referenzen von Henrick Jung Immobilien.">
  <PageHero eyebrow="Immobilien" title="Schon etwas <em>Passendes</em> gefunden?" lead="Hier finden Sie Objekte aus meiner Vermarktung – vom Familienhaus bis zur Kapitalanlage. Nicht das Richtige dabei? Teilen Sie mir Ihre Wünsche mit: Innerhalb von 24 Stunden präsentiere ich Ihnen passende Objekte." crumbs={[{ label: "Immobilien" }]}>
    <div class="btns"><a class="btn" href={u("kontakt/?anliegen=kaufen")}>Suchauftrag senden</a><a class="btn btn--line" href="#vermittelt">Referenzen ansehen</a></div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="hinweis reveal" role="note">
        <Icon name="clock" size={22} />
        <p><strong>Bitte beachten:</strong> Immobilienangebote ändern sich laufend. Die Objekte entsprechen dem zuletzt veröffentlichten Stand – einzelne Angebote können bereits verkauft oder vermietet sein. Fragen Sie die Verfügbarkeit gern unter <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a> oder per <a href={`mailto:${SITE.email}`}>E-Mail</a> an.</p>
      </div>

      <div class="filter" id="filter" hidden>
        <div class="filter__g" role="group" aria-label="Objektart">
          {[["alle", "Alle"], ["wohnen", "Wohnen kaufen"], ["anlage", "Anlage & Gewerbe"], ["mieten", "Mieten"]].map(([v, l], i) => <button type="button" class="chip-btn" data-f="kat" data-v={v} aria-pressed={i === 0 ? "true" : "false"}>{l}</button>)}
        </div>
        <div class="filter__g" role="group" aria-label="Region">
          {[["alle", "Alle Regionen"], ["Hamburg", "Hamburg"], ["Schleswig-Holstein", "Schleswig-Holstein"], ["Mecklenburg-Vorpommern", "Mecklenburg-Vorp."]].map(([v, l], i) => <button type="button" class="chip-btn" data-f="region" data-v={v} aria-pressed={i === 0 ? "true" : "false"}>{l}</button>)}
        </div>
        <p class="filter__n" aria-live="polite"><span id="fcount">{angebote.length}</span> Objekte</p>
      </div>
      <div class="grid g3" id="fgrid">{angebote.map((o, i) => <ObjektCard o={o} d={(i % 3) * 110} />)}</div>
      <p class="filter__leer" id="fleer" hidden>Für diese Auswahl ist gerade kein Objekt online. <a href={u("kontakt/?anliegen=kaufen")}>Suchauftrag senden</a> – ich melde mich mit passenden Angeboten.</p>
    </div>
  </section>

  <section class="section section--papier" id="vermittelt">
    <div class="container">
      <div class="head"><p class="eyebrow reveal">Referenzen</p><h2 class="reveal">Bereits <em>vermittelt</em></h2><p class="reveal">Diese Immobilien habe ich erfolgreich verkauft bzw. vermietet.</p></div>
      <div class="grid g4">
        {daten.vermittelt.map((v, i) => (
          <figure class="vm reveal" style={`--d:${(i % 4) * 80}ms`}>
            <div class="pic pic--r zoom"><Img src={v.bild.src} w={v.bild.w} h={v.bild.h} alt={`${v.typ} in ${v.ort}`} sizes="(min-width: 1024px) 25vw, (min-width: 720px) 50vw, 100vw" /><span class="vm__st">{v.status}</span></div>
            <figcaption>
              <strong>{v.titel ?? v.typ}</strong>
              <span>{v.typ} · {v.ort}</span>
              <span class="small">{[v.flaeche, v.zimmer && `${v.zimmer} Zimmer`].filter(Boolean).join(" · ")}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <Finale />
</BaseLayout>
<script>
  // Filter-Insel: wenige Zeilen Vanilla-JS, ohne JS bleibt die Liste vollständig.
  const box = document.getElementById("filter");
  if (box) {
    box.hidden = false;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#fgrid [data-kat]"));
    const st: Record<string, string> = { kat: "alle", region: "alle" };
    const apply = () => {
      let n = 0;
      cards.forEach((c) => {
        const ok = (st.kat === "alle" || c.dataset.kat === st.kat) && (st.region === "alle" || c.dataset.region === st.region);
        c.hidden = !ok; if (ok) { n++; c.classList.add("is-visible"); }
      });
      document.getElementById("fcount")!.textContent = String(n);
      document.getElementById("fleer")!.hidden = n > 0;
    };
    box.querySelectorAll<HTMLButtonElement>("button[data-f]").forEach((b) => b.addEventListener("click", () => {
      st[b.dataset.f!] = b.dataset.v!;
      box.querySelectorAll<HTMLButtonElement>(`button[data-f="${b.dataset.f}"]`).forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      const go = () => apply();
      (document as any).startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches ? (document as any).startViewTransition(go) : go();
    }));
  }
</script>
<style>
  .filter { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; padding: 14px; margin-bottom: 40px; border: 1px solid var(--linie); border-radius: 28px; background: var(--weiss); position: sticky; top: calc(var(--header-h) + 12px); z-index: 5; box-shadow: var(--shadow-sm); }
  .filter[hidden] { display: none; }
  .filter__g { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip-btn { border: 1px solid var(--silber-300); background: var(--weiss); border-radius: 999px; padding: 9px 16px; font-size: 14.5px; transition: background var(--t), color var(--t), border-color var(--t); }
  .chip-btn:hover { border-color: var(--ink); }
  .chip-btn[aria-pressed="true"] { background: var(--nacht); color: var(--weiss); border-color: var(--nacht); }
  .filter__n { margin: 0 8px 0 auto; font-size: 14px; color: var(--stein); }
  .filter__leer { margin-top: 24px; }
  #fgrid > [hidden] { display: none; }
  @media (max-width: 900px) { .filter { border-radius: var(--r-lg); position: static; } .filter__g { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; width: 100%; padding-bottom: 2px; } .chip-btn { flex: none; } .filter__n { margin-left: 0; } }

  .hinweis { display: flex; gap: 16px; align-items: flex-start; padding: 20px 24px; border: 1px solid var(--champagner-hell); background: #fbf8f2; border-radius: var(--r); margin-bottom: 64px; }
  .hinweis :global(.icon) { color: var(--champagner-text); flex: none; margin-top: 3px; }
  .hinweis p { margin: 0; max-width: none; font-size: 15.5px; }
  .mt { margin-top: 96px; }
  .vm { margin: 0; }
  .vm .pic { aspect-ratio: 3 / 2; }
  .vm__st { position: absolute; left: 12px; top: 12px; background: var(--ink); color: var(--weiss); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; padding: 4px 11px; border-radius: 999px; }
  .vm figcaption { display: grid; gap: 2px; margin-top: 14px; font-size: 15px; }
  .vm strong { font-family: var(--serif); font-weight: 500; font-size: 1.1rem; color: var(--ink); }
</style>
