---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import ObjektCard from "../../components/ObjektCard.astro";
import KontaktBand from "../../components/KontaktBand.astro";
import { u, SITE } from "../../consts";
import daten from "../../data/objekte.json";

export function getStaticPaths() {
  return daten.angebote.map((o) => ({ params: { slug: o.slug }, props: { o } }));
}
const { o } = Astro.props as { o: (typeof daten.angebote)[number] };
const [erst, ...rest] = o.bilder;
const weitere = daten.angebote.filter((x) => x.slug !== o.slug).slice(0, 3);
const mail = `mailto:${SITE.email}?subject=${encodeURIComponent(`Exposé-Anfrage: ${o.titel} (${o.ort})`)}&body=${encodeURIComponent(`Guten Tag Herr Jung,\n\nich interessiere mich für das Objekt „${o.titel}“ in ${o.ort} und bitte um Zusendung des Exposés.\n\nName:\nTelefon:\n\nViele Grüße`)}`;
const facts = [
  o.flaeche && { i: "area", k: o.flaecheLabel, v: o.flaeche },
  o.grundstueck && { i: "plot", k: "Grundstück", v: o.grundstueck },
  o.zimmer && { i: "rooms", k: "Zimmer", v: o.zimmer },
  o.baujahr && { i: "calendar", k: "Baujahr", v: o.baujahr },
].filter(Boolean) as { i: string; k: string; v: string }[];
const title = `${o.titel} – ${o.typ} in ${o.ort} | Henrick Jung Immobilien`;
const big = (src: string) => u(`${src}-1600.webp`);
---
<BaseLayout title={title} description={`${o.typ} in ${o.ort} (${o.region}): ${o.teaser} ${o.preisLabel}: ${o.preis}.`} ogImage={`${erst.src}-1600.webp`}>
  <section class="oh">
    <div class="container">
      <nav class="crumbs" aria-label="Brotkrumen"><a href={u("")}>Start</a><span aria-hidden="true">/</span><a href={u("immobilien/")}>Immobilien</a><span aria-hidden="true">/</span><span aria-current="page">{o.ort}</span></nav>
      <div class="oh__head">
        <div>
          <p class="eyebrow reveal"><Icon name="pin" size={16} /> {o.plz} {o.ort} · {o.region}</p>
          <h1 class="reveal" style="--d:80ms">{o.titel}</h1>
          {o.untertitel && <p class="oh__sub reveal" style="--d:140ms">{o.untertitel}</p>}
        </div>
        <div class="oh__preis reveal" style="--d:160ms"><small>{o.preisLabel}</small>{o.preis}</div>
      </div>
    </div>
    <div class="container">
      <div class="gal" data-gallery>
        <a class="gal__main pic pic--r reveal-img" href={big(erst.src)} data-i="0"><Img src={erst.src} w={erst.w} h={erst.h} alt={`${o.typ} in ${o.ort} – Ansicht 1`} eager sizes="(min-width: 1024px) 66vw, 100vw" /></a>
        {rest.slice(0, 4).map((bb, i) => (
          <a class="gal__th pic pic--r reveal-img" style={`--d:${120 + i * 90}ms`} href={big(bb.src)} data-i={i + 1}>
            <Img src={bb.src} w={bb.w} h={bb.h} alt={`${o.typ} in ${o.ort} – Ansicht ${i + 2}`} sizes="(min-width: 1024px) 17vw, 50vw" />
            {i === 3 && rest.length > 4 && <span class="gal__more">+{rest.length - 4} Bilder</span>}
          </a>
        ))}
        {rest.slice(4).map((bb, i) => <a class="visually-hidden" href={big(bb.src)} data-i={i + 5} tabindex="-1">Bild {i + 6}</a>)}
      </div>
    </div>
  </section>

  <section class="section od">
    <div class="container od__grid">
      <div class="od__main">
        <ul class="facts reveal">
          {facts.map((f) => <li><Icon name={f.i} size={22} /><span><small>{f.k}</small>{f.v}</span></li>)}
        </ul>
        <p class="lead reveal">{o.teaser}</p>

        <h2 class="reveal">Beschreibung</h2>
        <div class="prose">
          {o.beschreibung.map((bl: any) => bl.t === "ul" ? <ul class="check">{bl.items.map((x: string) => <li>{x}</li>)}</ul> : bl.t === "h" ? <h3>{bl.text}</h3> : <p>{bl.text}</p>)}
        </div>

        <h2 class="reveal">Ausstattung</h2>
        <ul class="check aus">{o.ausstattung.map((x) => <li class:list={{ sub: x.startsWith("–") }}>{x.replace(/^– /, "")}</li>)}</ul>

        <h2 class="reveal">Lage</h2>
        <div class="prose">
          {o.lage.map((bl: any) => bl.t === "ul" ? <ul class="check">{bl.items.map((x: string) => <li>{x}</li>)}</ul> : bl.t === "h" ? <h3>{bl.text}</h3> : <p>{bl.text}</p>)}
        </div>
      </div>

      <aside class="od__side">
        <div class="box">
          <h2 class="box__h">Informationen zur Immobilie</h2>
          <dl class="info">{o.infos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          <a class="btn" href={mail}><Icon name="mail" size={18} /> Exposé anfordern</a>
          <a class="btn btn--line" href={`tel:${SITE.phoneTel}`}><Icon name="phone" size={18} /> {SITE.phoneDisplay}</a>
          <p class="small">Alle Angaben laut Verkäufer bzw. Exposé, ohne Gewähr. Das Angebot kann bereits vergeben sein – bitte Verfügbarkeit anfragen.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container">
      <div class="head"><p class="eyebrow">Weitere Immobilien</p><h2>Das könnte Sie auch <em>interessieren</em></h2></div>
      <div class="grid g3">{weitere.map((w, i) => <ObjektCard o={w} d={i * 110} />)}</div>
    </div>
  </section>
  <KontaktBand />

  <dialog class="lb" id="lb" aria-label="Bildergalerie">
    <img alt="" />
    <button class="lb__x" type="button" aria-label="Galerie schließen"><Icon name="close" size={26} /></button>
    <button class="lb__prev" type="button" aria-label="Vorheriges Bild"><Icon name="arrow-left" size={26} /></button>
    <button class="lb__next" type="button" aria-label="Nächstes Bild"><Icon name="arrow" size={26} /></button>
    <p class="lb__count" aria-live="polite"></p>
  </dialog>
</BaseLayout>

<script>
  // Leichte Lightbox (<dialog>). Ohne JS öffnen die Links das große Bild direkt.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-gallery] a[data-i]"));
  const lb = document.getElementById("lb") as HTMLDialogElement | null;
  if (lb && links.length && "showModal" in lb) {
    const img = lb.querySelector("img")!;
    const count = lb.querySelector(".lb__count")!;
    let i = 0;
    const show = (n: number) => {
      i = (n + links.length) % links.length;
      img.src = links[i].href;
      img.alt = links[i].querySelector("img")?.alt ?? `Bild ${i + 1}`;
      count.textContent = `${i + 1} / ${links.length}`;
    };
    links.forEach((a, n) => a.addEventListener("click", (e) => { e.preventDefault(); show(n); lb.showModal(); }));
    lb.querySelector(".lb__x")!.addEventListener("click", () => lb.close());
    lb.querySelector(".lb__prev")!.addEventListener("click", () => show(i - 1));
    lb.querySelector(".lb__next")!.addEventListener("click", () => show(i + 1));
    lb.addEventListener("keydown", (e) => { if (e.key === "ArrowLeft") show(i - 1); if (e.key === "ArrowRight") show(i + 1); });
    lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
  }
</script>

<style>
  .oh { padding-top: 32px; background: var(--papier); padding-bottom: 8px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--stein); margin-bottom: 24px; }
  .crumbs a { color: var(--stein); }
  .oh__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 40px; margin-bottom: 32px; }
  .oh__head h1 { font-size: clamp(2rem, 4.4vw, 3.4rem); max-width: 860px; margin-bottom: 8px; }
  .oh__sub { font-family: var(--serif); font-style: italic; font-size: 1.2rem; color: var(--graphit); margin: 0; }
  .oh__preis { font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--ink); display: grid; line-height: 1.15; }
  .oh__preis small { font-family: var(--sans); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
  .gal { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; margin-bottom: -48px; position: relative; z-index: 1; }
  .gal__main { grid-column: 1 / -1; aspect-ratio: 3 / 2; }
  .gal__th { aspect-ratio: 3 / 2; display: block; }
  @media (min-width: 1024px) {
    .gal { grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, 1fr); height: 560px; }
    .gal__main { grid-column: 1; grid-row: 1 / span 2; aspect-ratio: auto; }
    .gal__th { aspect-ratio: auto; }
  }
  .gal a :global(img) { transition: transform 1s var(--ease); }
  .gal a:hover :global(img) { transform: scale(1.04); }
  .gal__more { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(20,20,20,.5); color: var(--weiss); font-weight: 600; letter-spacing: .05em; }
  .od { padding-top: 112px; }
  .od__grid { display: grid; gap: 56px; }
  @media (min-width: 1024px) { .od__grid { grid-template-columns: 1fr 380px; gap: 72px; align-items: start; } .od__side { position: sticky; top: calc(var(--header-h) + 24px); } }
  .od__main { min-width: 0; }
  .od__main h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-top: 56px; }
  .prose p, .prose h3 { max-width: 72ch; }
  .prose h3 { font-size: 1.2rem; margin-top: 24px; }
  .prose .check { margin: 8px 0 20px; }
  .aus { gap: 10px; }
  .aus li.sub { padding-left: 36px; grid-template-columns: 22px 1fr; font-size: 15.5px; color: var(--stein); }
  .facts { list-style: none; padding: 0; margin: 0 0 32px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--linie); border: 1px solid var(--linie); border-radius: var(--r); overflow: hidden; }
  @media (min-width: 720px) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .facts li { background: var(--weiss); padding: 18px; display: flex; gap: 12px; align-items: center; }
  .facts :global(.icon) { color: var(--champagner-text); flex: none; }
  .facts span { display: grid; line-height: 1.3; font-weight: 600; font-size: 15.5px; }
  .facts small { font-weight: 400; font-size: 12.5px; }
  .box { border: 1px solid var(--linie); border-radius: var(--r-lg); padding: 28px; background: var(--weiss); display: grid; gap: 12px; box-shadow: var(--shadow-sm); }
  .box__h { font-size: 1.35rem; }
  .info { margin: 0 0 12px; }
  .info div { display: grid; grid-template-columns: 1fr 1.2fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--linie); font-size: 14.5px; }
  .info dt { color: var(--stein); }
  .info dd { margin: 0; font-weight: 500; color: var(--ink); overflow-wrap: anywhere; }
  .box .small { margin: 4px 0 0; }
  .lb { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(10,10,10,.94); }
  .lb[open] { display: grid; place-items: center; }
  .lb::backdrop { background: rgba(0,0,0,.7); }
  .lb img { max-width: min(92vw, 1600px); max-height: 82vh; width: auto; height: auto; object-fit: contain; border-radius: 6px; }
  .lb button { position: absolute; width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(255,255,255,.4); background: rgba(20,20,20,.5); color: var(--weiss); display: grid; place-items: center; }
  .lb__x { top: 20px; right: 20px; }
  .lb__prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb__next { right: 16px; top: 50%; transform: translateY(-50%); }
  .lb__count { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: #ddd; margin: 0 auto; }
</style>
